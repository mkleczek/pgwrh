-- The build appends the replacement function and view definitions.
ALTER TABLE replication_group_config_lock ADD COLUMN rollback_unlock boolean;
ALTER TABLE replication_group_member
    ADD COLUMN prepared_remote_shards json NOT NULL DEFAULT '[]',
    ADD COLUMN serving_subtrees json NOT NULL DEFAULT '[]';
ALTER FOREIGN TABLE fdw_replica_state
    ADD COLUMN prepared_remote_shards json,
    ADD COLUMN serving_subtrees json;
ALTER FOREIGN TABLE fdw_shard_assignment ADD COLUMN shard_server_members text[];
CREATE FOREIGN TABLE fdw_serving_subtree (member_role text, schema_name text, table_name text)
SERVER replica_controller OPTIONS (table_name 'serving_subtree');

DROP VIEW sync;
DROP VIEW shard_structure;
ALTER FOREIGN TABLE fdw_shard_structure
    DROP COLUMN create_table,
    ADD COLUMN parent_schema_name text,
    ADD COLUMN parent_table_name text,
    ADD COLUMN bound text,
    ADD COLUMN parent_partkeydef text,
    ADD COLUMN node_partkeydef text,
    ADD COLUMN is_leaf boolean,
    ADD COLUMN root_column_clause text,
    ADD COLUMN local_constraint_clause text,
    ADD COLUMN root_schema_name text,
    ADD COLUMN root_table_name text;

DO $$
DECLARE
    s record;
BEGIN
    FOR s IN SELECT srvname FROM owned_server LOOP
        EXECUTE format('ALTER SERVER %I OPTIONS (SET analyze_sampling %L)', s.srvname, 'auto');
    END LOOP;
END
$$;
